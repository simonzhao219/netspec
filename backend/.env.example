# NetSpec — 環境變數範本
# 複製為 .env 並填入真實值：cp .env.example .env
# .env 已加入 .gitignore，絕對不要 commit 真實 Key

# ── LLM 模式 ──────────────────────────────────────────────────────────────────
USE_OLLAMA=false                        # true = 使用本機 Ollama，false = 使用 API

# ── Azure AI Services（USE_OLLAMA=false 時必填）────────────────────────────────
API_BASE_URL=https://your-resource.cognitiveservices.azure.com
API_KEY=your-azure-api-key-here
API_VERSION=2025-04-01-preview

# ── Databricks Model Serving（可選，部署到 Databricks 時填）────────────────────
DATABRICKS_HOST=https://adb-xxxxxxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI direct（可選）──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Ollama（USE_OLLAMA=true 時使用）───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ── Per-step 模型分配 ──────────────────────────────────────────────────────────
# 格式：model 名稱 或 provider:model（e.g. databricks:databricks-claude-3-7-sonnet）
# 留空則 fallback 到 DEFAULT_MODEL
DEFAULT_MODEL=claude-opus-4-6-2026V2

LLM_PARSE=gpt-5.4                      # Step 1  需求解析
LLM_SOCRATIC=gpt-5.4                   # Step 2  Socratic 追問
LLM_PLAN=gpt-5.4                       # Step 3  搜尋規劃
LLM_ANALYZE=gpt-5.4                    # Step 5  社群分析
LLM_EDGES=gpt-5.4                      # Step 6  邊界偵測
LLM_PRD=claude-opus-4-6-2026V2         # Step 7  PRD 生成（最重要）
LLM_VALIDATE=gpt-5.4                   # Step 8  品質校驗
LLM_TRANSLATE=gpt-5.4                  # 翻譯
LLM_ITERATE=gpt-5.4                    # 迭代優化

# ── Figma 獨立模型（留空則 fallback 到 LLM_SOCRATIC / LLM_PRD）────────────────
LLM_FIGMA_QUESTIONS=                   # Figma 追問
LLM_FIGMA_STORY=                       # Figma Story / 功能清單生成

# ── 費用管控 ──────────────────────────────────────────────────────────────────
RATE_LIMIT_MODE=api                    # ollama = 嚴格限制；api = 每日次數上限
DAILY_START_LIMIT=30                   # 每天最多完整分析次數
DAILY_ITERATE_LIMIT=60                 # 每天最多優化次數

# ── 加密金鑰（Figma OAuth token 加密用）──────────────────────────────────────
# 產生指令：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=your-fernet-key-here

# ── Figma ─────────────────────────────────────────────────────────────────────
FIGMA_TOKEN=your-figma-personal-access-token
FIGMA_CLIENT_ID=your-figma-oauth-client-id
FIGMA_CLIENT_SECRET=your-figma-oauth-client-secret
FIGMA_REDIRECT_URI=http://localhost:8000/api/figma/oauth/callback
FRONTEND_URL=your-frontend-url（例如 http://localhost:3000）

# ── App Telemetry（SDCL PoC）─────────────────────────────────────────────────
# 主路徑是 stdout → Databricks Apps 自動匯出到 Unity Catalog otel_logs，程式面零設定，
# 本機開發時 stdout 就直接印在終端機上，不用填任何東西。
#
# 下面兩個是「直寫 Delta table」這條備援路徑的開關，兩個都填才會啟用。
# 詳見 doc/SDCL_telemetry_deployment.md。
TELEMETRY_APP_NAME=netspec              # 哪一個 EP app（netspec / bugzapper / polaris）
TELEMETRY_SERVICE_NAME=                 # 留空由 main.py 自動填入服務名稱
TELEMETRY_TABLE=                        # e.g. ep_dev.netspec.app_events（留空 = 不直寫）
TELEMETRY_WAREHOUSE_ID=                 # SQL warehouse id（留空 = 不直寫）

# ── 其他 ──────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
MAX_SOCRATIC_ROUNDS=5
CLARITY_THRESHOLD=70
